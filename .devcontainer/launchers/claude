#!/usr/bin/env bash
# Claude Code launcher: resolves the CLI from the tools config copy with
# `mise which claude`, isolated per TD §3.3 and run from /, then execs it
# with the caller's own arguments, working directory, and environment.
# Never installs anything.
set -euo pipefail
AIDC_LAUNCHERS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/common.sh
source "$AIDC_LAUNCHERS/../lib/common.sh"
# shellcheck source=../lib/mise-isolation.sh
source "$AIDC_LIB/mise-isolation.sh"

not_launchable="claude is not installed in the tools config copy: run 'mise run aidc:sync'"
exe="$(
	aidc::mise_isolate || exit 1
	mise which claude
)" || aidc::die "$not_launchable"
[ -n "$exe" ] || aidc::die "$not_launchable"

exec "$exe" "$@"
