#!/usr/bin/env bash
# Codex CLI launcher: resolves the CLI from the tools config copy with
# `mise which codex`, isolated per TD §3.3 and run from /, then execs it in
# the caller's own working directory and environment. Starts the
# interactive CLI (no command, a prompt, `resume`, or `fork`) with
# --no-daemon unless --remote or --no-daemon is given, and refuses the
# commands that start or need the managed app-server daemon. Everything else
# passes through unchanged. Never installs anything.
set -euo pipefail
AIDC_LAUNCHERS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/common.sh
source "$AIDC_LAUNCHERS/../lib/common.sh"
# shellcheck source=../lib/mise-isolation.sh
source "$AIDC_LIB/mise-isolation.sh"
# shellcheck source=../lib/codex-cli.sh
source "$AIDC_LIB/codex-cli.sh"

# in_table <array-name> <word>: whether <word> is an element of the array.
in_table() {
	local -n table="$1"
	local item
	for item in "${table[@]}"; do
		[ "$item" != "$2" ] || return 0
	done
	return 1
}

# scan <stop> <value-table> <multi-table> <arg>...
# Scans <arg>... left to right into option and positional tokens. `--` ends
# options. `--opt=value` and an attached short value (`-mo3`) are one option
# token; an option in <value-table> or <multi-table> written as a separate
# word consumes the next token as its value, which is never read as a flag.
# With <stop> 1 the scan stops at the first positional token before `--`.
# Sets POS (that token's index, or -1), REMOTE and NO_DAEMON (1 when that
# flag was an option token), and SPLIT (1 when a <multi-table> option was
# written as separate words before POS).
scan() {
	local stop="$1" values="$2" multi="$3" i=0 tok name
	shift 3
	POS=-1 REMOTE=0 NO_DAEMON=0 SPLIT=0
	local -a args=("$@")
	while [ "$i" -lt "${#args[@]}" ]; do
		tok="${args[i]}"
		case "$tok" in
		--) return 0 ;;
		--?*=*) name="${tok%%=*}" ;;
		--?* | -?) name="$tok" ;;
		-?*) name="" ;;
		*)
			if [ "$stop" = 1 ]; then
				POS="$i"
				return 0
			fi
			i=$((i + 1))
			continue
			;;
		esac
		case "$name" in
		--remote) REMOTE=1 ;;
		--no-daemon) NO_DAEMON=1 ;;
		esac
		if [ "$name" = "$tok" ]; then
			if in_table "$multi" "$name"; then
				SPLIT=1
				i=$((i + 1))
			elif in_table "$values" "$name"; then
				i=$((i + 1))
			fi
		fi
		i=$((i + 1))
	done
}

daemon_refusal() {
	aidc::die "codex $1 needs the managed app-server daemon, which aidc containers do not run"
}

not_launchable="codex is not installed in the tools config copy: run 'mise run aidc:sync'"
exe="$(
	aidc::mise_isolate || exit 1
	mise which codex
)" || aidc::die "$not_launchable"
[ -n "$exe" ] || aidc::die "$not_launchable"

args=("$@")
scan 1 AIDC_CODEX_VALUE_OPTIONS AIDC_CODEX_MULTI_VALUE_OPTIONS "${args[@]}"
pos="$POS" remote="$REMOTE" no_daemon="$NO_DAEMON"
if [ "$SPLIT" = 1 ] && [ "$pos" -ge 0 ]; then
	aidc::die "codex: write --image=<file> once per file, so the command can be identified"
fi

command=""
if [ "$pos" -ge 0 ] && in_table AIDC_CODEX_COMMANDS "${args[pos]}"; then
	command="${args[pos]}"
fi
rest=("${args[@]:pos+1}")

case "$command" in
agents | remote-control) daemon_refusal "$command" ;;
app-server)
	scan 1 AIDC_CODEX_APP_SERVER_VALUE_OPTIONS AIDC_CODEX_MULTI_VALUE_OPTIONS "${rest[@]}"
	if [ "$POS" -ge 0 ]; then
		case "${rest[POS]}" in
		# proxy only talks to a running daemon's control socket.
		daemon | proxy) daemon_refusal "app-server ${rest[POS]}" ;;
		esac
	fi
	;;
resume | fork)
	scan 0 AIDC_CODEX_RESUME_VALUE_OPTIONS AIDC_CODEX_MULTI_VALUE_OPTIONS "${rest[@]}"
	if [ "$remote$no_daemon$REMOTE$NO_DAEMON" = 0000 ]; then
		args=("${args[@]:0:pos+1}" --no-daemon "${rest[@]}")
	fi
	;;
"")
	# No command: a prompt, if any, and every option token after it.
	if [ "$pos" -ge 0 ]; then
		scan 0 AIDC_CODEX_VALUE_OPTIONS AIDC_CODEX_MULTI_VALUE_OPTIONS "${rest[@]}"
		remote=$((remote | REMOTE)) no_daemon=$((no_daemon | NO_DAEMON))
	fi
	if [ "$remote$no_daemon" = 00 ]; then
		args=(--no-daemon "${args[@]}")
	fi
	;;
esac

exec "$exe" "${args[@]}"
