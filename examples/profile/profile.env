# Local configuration for one environment profile. Copied by
# `mise run profile:new <name>`; never committed.

# Agent state and shell history profiles. Empty inherits this profile's name.
# Give the same name in several profiles to share that state.
PROFILE_CLAUDE=
PROFILE_CODEX=
PROFILE_SHELL=

# The Docker socket lets the container control every container on the host.
# Only 'on' and 'off' are accepted.
DOCKER_SOCKET=off

# At every container start, when online: START_UPDATE_MISE=on updates mise to
# its newest release; START_UPGRADE_TOOLS=on upgrades the container tools as
# `aidc:update` does. Offline, both skip their updates. Only 'on' and 'off'
# are accepted.
START_UPDATE_MISE=off
START_UPGRADE_TOOLS=off

# 'on' keeps the container running after its VS Code window closes; 'off'
# stops it. Takes effect after `profile:code` and "Rebuild Container".
KEEP_RUNNING=off

# Values are taken literally: quotes are kept as characters, and a '$'
# reaches Compose escaped as '$$' so it stays literal. Only whole-line '#'
# comments are allowed.

# Git identity used inside this profile's container. Empty sets none. For
# example:
#   GIT_AUTHOR_NAME=Example Developer
#   GIT_AUTHOR_EMAIL=developer@example.com
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
GIT_SSH_COMMAND=
